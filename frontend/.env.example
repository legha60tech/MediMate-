# Copy this file to .env (same folder) and adjust if needed.
# Frontend: the base path for API calls. Vite proxies /api to the backend in dev.
VITE_API_BASE_URL=/api
# Where the Vite dev server forwards /api requests (the FastAPI backend).
VITE_API_PROXY_TARGET=http://localhost:8000
# If true, the app falls back to built-in demo data when the backend is offline.
VITE_USE_DEMO_FALLBACK=true
