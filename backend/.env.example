# Copy to .env in the backend folder. Defaults are safe for the expo.
MEDIMATE_DEVICE_MODE=simulation
MEDIMATE_SEED_DEMO=true
MEDIMATE_ENABLE_DEMO_CLOCK=true
MEDIMATE_OVERDUE_GRACE_MINUTES=30
MEDIMATE_DISPENSE_EARLY_MINUTES=60
MEDIMATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: override the database location
# MEDIMATE_DATABASE_URL=sqlite:///./medimate.db
